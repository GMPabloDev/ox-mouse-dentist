{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=mousedent.db"
  },
  "Jwt": {
    "Issuer": "MouseDent",
    "Audience": "MouseDent",
    "SigningKey": "dev-only-mousedent-signing-key-change-in-production",
    "AccessTokenMinutes": 480
  },
  "Seed": {
    "Enabled": false
  },
  "Api": {
    "EnableDocumentation": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "AutoMigrate": false
  },
  "RateLimits": {
    "LoginPermitLimit": 10,
    "PasswordRecoveryPermitLimit": 5,
    "WindowSeconds": 60
  },
  "StaffAccess": {
    "PublicBaseUrl": ""
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "MouseDent"
  }
}
